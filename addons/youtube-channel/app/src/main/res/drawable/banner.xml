<?xml version="1.0" encoding="utf-8"?>
<!-- The TV banner: the channel's own picture, centred on a dark field. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp" android:height="180dp">
    <item>
        <shape><solid android:color="#FF141414" /></shape>
    </item>
    <item android:width="180dp" android:height="180dp" android:gravity="center"
        android:drawable="@drawable/channel_picture" />
</layer-list>
