<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for showOnWake: a foreground service hears the screen turn on, started again after each boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 10 and later only let an app open a screen from the background when it may draw over other
         apps; the install script grants it. On Android 9 it is not needed. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Only for turnTvOn: an alarm on the minute the window opens and closes, and the screen woken with it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Only for email: the mail server in mail.json, and nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name">

        <!-- The board: the app's own tile and, on the cleanyourtv launcher, its module card. -->
        <activity
            android:name=".BoardActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <!-- The install script writes routine.json here with `content write`. Write-only, one file name, and only
             the ADB shell may call it. -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="${applicationId}.config"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />

        <!-- Keeps the screen-on receiver registered: SCREEN_ON cannot be received from the manifest. Exported only
             to callers holding WRITE_SECURE_SETTINGS (the adb shell), so the install script can start it. -->
        <service
            android:name=".WatchService"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Opens the morning board when the screen turns on during the morning" />
        </service>

        <!-- Not exported: the system's boot, package-replaced and clock broadcasts still reach it, other apps cannot. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- turnTvOn's alarms, sent by the app's own PendingIntents. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <!-- Only for music: Android hands an app the music app's media session while it holds an allowed notification
             listener. It reads no notifications; the install script allows it. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Its only job is the "lock screen" global action, which on Android 9 and later puts the TV to standby: an
             ordinary app has no other way to. It asks for no events and cannot read the screen. -->
        <service
            android:name=".SleepService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/sleep_service" />
        </service>
    </application>
</manifest>
